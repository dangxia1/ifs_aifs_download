# 3161 实时预报下载配置
# 每小时运行一次，每次覆盖最新数据，永远只保留最新一套

# 关键时次: 0-144h, 步长 6h (25 个时次, 覆盖未来 6 天)
steps:
  ifs: [0, 6, 12, 18, 24, 30, 36, 42, 48, 54, 60, 66, 72, 78, 84, 90, 96, 102, 108, 114, 120, 126, 132, 138, 144]
  aifs-single: [0, 6, 12, 18, 24, 30, 36, 42, 48, 54, 60, 66, 72, 78, 84, 90, 96, 102, 108, 114, 120, 126, 132, 138, 144]

# 额外下载时次 (仅用于降水差分标注, 不画图): step=144 图的未来 12h/24h 降水需要 156/168
steps_extra: [156, 168]

# 模型
# 模型 (key: ECMWF model名, value: 输出子目录名)
models:
  ifs: ifs
  aifs-single: aifs

# 数据源 ( ecmwf 不稳定，使用 google)
source: "google"

# 气象要素
single_params: ["tp"]
level_params: ["q", "u", "v", "t", "gh"]
levels: [1000, 925, 850, 700, 500, 300, 250, 200, 50]

# 重试
retry_max: 3
retry_interval: 10

# AR 阈值目录 (老师的 ERA5 气候态 85% 阈值)
threshold_dir: "/shared_data_5/ntfs2/liangju/ARIA_Asia_v15/ERA5"

# 输出路径 (服务器: /shared_data/zongshen/ec_realtime)
save_dir: "/shared_data/zongshen/ec_realtime"

# ── 可视化参数 (visualize_ivt.py 读取, 可随时调整, 无需改代码) ──
visual:
  # 地图底图: bluemarble (卫星影像) / shadedrelief (地形阴影, 2026-08-07 老师要求)
  basemap_style: "shadedrelief"

  # AR 河轴主链: 实心红点大小 (按区域; 全球小、华北大)
  axis_dot_size:
    global: 2
    east_asia: 8
    north_china: 50

  # 被过滤的候选分支: 空心点大小 + 颜色 (粉, 与主链红色区分, 2026-08-07 老师要求)
  removed_dot_size:
    global: 24
    east_asia: 30
    north_china: 90
  removed_dot_color: "#ff69b4"   # 粉红 (hot pink)

  # 降水 4 级颜色 (大雨/暴雨/大暴雨/特大暴雨; 色相拉开, 与 IVT 蓝黄橙红区分)
  precip_colors:
    - "#8BC34A"   # 大雨: 草绿
    - "#00BCD4"   # 暴雨: 青
    - "#9C27B0"   # 大暴雨: 紫
    - "#FF4081"   # 特大暴雨: 品红